  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.0",
    "aws-cdk": "2.1147.0",
    "aws-sdk-client-mock": "4.1.0",
    "cdk-nag": "3.0.2",
    "eslint": "10.14.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
