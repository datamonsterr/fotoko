          "AwsIotSqlVersion": "2016-03-23",
          "RuleDisabled": false,
          "Sql": "SELECT *, topic(3) AS printerId FROM 'fotoko/printers/+/+' WHERE topic(4) = 'status' OR topic(4) = 'heartbeat'",
        },
      },
      "Type": "AWS::IoT::TopicRule",
    },
