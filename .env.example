# Fotoko environment reference. Copy to `.env` and fill in; `.env` is git-ignored. Never commit
# real values, and never put a secret into an EXPO_PUBLIC_* variable (it ships inside the app).
#
# How the values reach the code:
#   - Rust binaries and shell scripts read the real process environment. Nothing loads `.env`
#     for them: run `set -a; . ./.env; set +a` first (values below contain no spaces or quotes,
#     so the file is also valid shell), or pass variables inline.
#   - Expo (apps/mobile) loads `.env` from the app directory itself: copy the EXPO_PUBLIC_*
#     block to `apps/mobile/.env` (or export it). They are inlined at build time.
#   - Deployed on AWS, CDK sets the Lambda variables and payOS credentials live in Secrets
#     Manager; you do not set section 1 yourself.
#   - The Pi agent is configured by /etc/fotoko/agent.toml, not by environment (section 5).
#
# Convention: an uncommented line is something a local developer normally sets. A commented
# line (`# NAME=value`) shows an optional variable with its default or an example.
# Legend per variable: required/optional, default, example, where to get it, secret or not.
# `bash scripts/dev/check-env.sh` verifies that this file and the code agree.

# =====================================================================================
# 1. API Lambdas in AWS (fotoko-http, fotoko-iot-status, fotoko-expire)
#    Set by infra/cdk/lib/functions.ts. Listed so you know what a deployed Lambda sees and
#    can reproduce it locally. Not secrets (the payOS secret is referenced by ARN only).
# =====================================================================================

# Runtime mode. Required. `aws` for the Lambdas (they refuse to start in `local`);
# `local` selects the in-memory/simulated server (section 2).
# FOTOKO_MODE=aws

# DynamoDB single table. Required in aws mode (all three Lambdas). Example: fotoko-dev.
# CDK output `TableName`.
# TABLE_NAME=fotoko-dev

# S3 bucket for uploaded photos. Required in aws mode (fotoko-http). CDK output `BucketName`.
# BUCKET_NAME=

# IoT Core data endpoint, an https URL or host: `aws iot describe-endpoint --endpoint-type
# iot:Data-ATS`. Required in aws mode (fotoko-http). CDK output `IotEndpoint` is the host.
# IOT_DATA_ENDPOINT=

# ARN of the Secrets Manager secret holding JSON {"clientId","apiKey","checksumKey"}.
# Required in aws mode (fotoko-http). SECRET VALUE: set it with `aws secretsmanager
# put-secret-value` (docs/setup/aws.md); the ARN itself is not secret.
# PAYOS_SECRET_ARN=

# Public base URL of the web app (the CloudFront URL, CDK output `WebUrl`). Required in aws
# mode. payOS returnUrl/cancelUrl are built from it. In local mode it defaults to
# http://localhost:8081 and is set below.
# PUBLIC_APP_URL=https://dxxxxxxxxxxxx.cloudfront.net

# --- shared by Lambda and local server ---

# payOS API base URL. Optional. Default https://api-merchant.payos.vn. The e2e/compose
# stack points it at the payOS mock.
# PAYOS_BASE_URL=https://api-merchant.payos.vn

# Price of one print in VND when a printer item has no pricePerPrintVnd. Optional, default
# 10000, positive integer.
# DEFAULT_PRICE_VND=10000

# Log filter for tracing-subscriber (API Lambdas, local server, Pi agent). Optional, default
# `info`. Example: `info,fotoko_api=debug`.
# RUST_LOG=info

# AWS region. Set by the Lambda runtime; the SDK, the AWS CLI and scripts/deploy/aws.sh read
# it (aws.sh default ap-southeast-1). Everything in this project lives in ap-southeast-1.
# AWS_REGION=ap-southeast-1

# =====================================================================================
# 2. Local / simulated server (fotoko-local, `cargo run -p fotoko-api --features local
#    --bin fotoko-local`; also docker compose). No AWS needed.
# =====================================================================================

FOTOKO_MODE=local

# payOS credentials. Required by fotoko-local (any non-empty value works against the payOS
# mock; the compose stack uses local-client-id / local-api-key / local-checksum-key).
# Real values: payOS dashboard (https://my.payos.vn) -> your payment channel ->
# "Client ID", "API Key", "Checksum Key" (docs/setup/services.md). SECRETS.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Where the browser reaches the web app; payOS return/cancel URLs and (unless
# FOTOKO_LOCAL_PUBLIC_URL is set) nothing else. Optional, default http://localhost:8081.
PUBLIC_APP_URL=http://localhost:8081

# Listen address of fotoko-local, an IP:port (not a hostname). Optional, default
# 127.0.0.1:8787. Port 0 picks a free port and prints it.
# FOTOKO_LOCAL_ADDR=127.0.0.1:8787

# Base URL of the presigned-style photo URLs the server hands out; the browser (upload) and
# the Pi agent (download) must both reach it. Optional, default http://<FOTOKO_LOCAL_ADDR>.
# FOTOKO_LOCAL_PUBLIC_URL=http://localhost:8081

# Directory for uploaded photos. Optional, default <system temp>/fotoko-local.
# FOTOKO_LOCAL_DIR=/tmp/fotoko-local

# Secret for signing local photo URLs. Optional (random per run when unset). SECRET, any
# string; demo value only locally.
# FOTOKO_LOCAL_SECRET=local-url-secret

# Comma separated printer ids to seed as online. Optional, default stand-001.
# FOTOKO_LOCAL_PRINTERS=stand-001

# MQTT broker for print jobs. Optional: unset means jobs are only recorded and no Pi gets
# them. Must start with mqtt:// or tcp://. `cargo run -p fotoko-e2e --bin fotoko-sim-broker`
# starts one on 127.0.0.1:1883.
# FOTOKO_MQTT_URL=mqtt://127.0.0.1:1883

# Local mode identifies callers by the `x-fotoko-identity` header (no variable).

# =====================================================================================
# 3. Mobile app (apps/mobile, Expo). Public: inlined into the bundle at build time.
# =====================================================================================

# Backend base URL. Optional, default http://localhost:8787 (fotoko-local). For AWS use the
# CDK output `ApiUrl` (https://<id>.execute-api.ap-southeast-1.amazonaws.com).
EXPO_PUBLIC_API_URL=http://localhost:8787

# `local` sends an x-fotoko-identity header; `aws` (the default for anything but `local`)
# signs requests with Cognito guest credentials (SigV4).
EXPO_PUBLIC_FOTOKO_MODE=local

# aws mode only. Required there. Region of the identity pool and API: ap-southeast-1.
# EXPO_PUBLIC_AWS_REGION=ap-southeast-1

# aws mode only. Required there. CDK output `IdentityPoolId`, e.g. ap-southeast-1:<uuid>.
# EXPO_PUBLIC_COGNITO_IDENTITY_POOL_ID=

# =====================================================================================
# 4. CDK / deploy (infra/cdk, scripts/deploy/aws.sh). Deploy credentials are NOT here: use
#    an AWS profile or SSO locally, the GitHub OIDC role in CI (docs/setup/aws.md).
#    CDK context flags are -c options, not variables: -c stage=dev|prod, -c deployWeb=true,
#    -c alarmEmail=ops@example.com, -c extraOrigins=https://a.example,https://b.example.
# =====================================================================================

# Stage to deploy. Optional, default dev (aws.sh sets it from its dev|prod argument; `-c stage`
# wins over it). One CloudFormation stack per stage: Fotoko-dev, Fotoko-prod.
# FOTOKO_STAGE=dev

# Directory with the cargo-lambda output (<name>/bootstrap per Lambda). Optional, default
# <repo>/target/lambda; relative paths resolve from the repo root. For a synth without a Rust
# build use infra/cdk/test/fixtures/lambda.
# FOTOKO_LAMBDA_DIR=target/lambda

# AWS account id CDK deploys into. Set by the CDK CLI from your credentials; only set it by
# hand to override. Not a secret, but do not publish it with other identifiers.
# CDK_DEFAULT_ACCOUNT=123456789012

# =====================================================================================
# 5. Pi agent. Configured by /etc/fotoko/agent.toml (docs/contracts.md, deploy/pi/README.md),
#    written by `pnpm --filter @fotoko/infra provision-printer`. The device certificate and
#    private key are SECRETS: they live in /etc/fotoko on the Pi and the operator's
#    printer-out/ directory, never in git. Environment only for tooling:
# =====================================================================================

# glibc level deploy/pi/build.sh pins with cargo-zigbuild. Optional, default 2.36 (bookworm;
# also runs on trixie).
# FOTOKO_GLIBC=2.36

# Alternate filesystem root for deploy/pi/install.sh. Used by deploy/pi/test/install_test.sh
# only; never set it on a real Pi.
# FOTOKO_ROOT=

# =====================================================================================
# 6. Tests, simulation and e2e
# =====================================================================================

# 1 enables the DynamoDB Local + MinIO integration tests (crates/api/tests/aws_integration.rs)
# and `repro.sh rust-integration`. Needs `docker compose -f docker-compose.test.yml up -d`.
# FOTOKO_IT=1
# FOTOKO_IT_DYNAMODB_URL=http://127.0.0.1:18000
# FOTOKO_IT_S3_URL=http://127.0.0.1:19000

# Dummy credentials for the integration tests (DynamoDB Local and MinIO accept anything;
# the AWS SDK still wants some). repro.sh defaults both to `test`. NOT real credentials.
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# 1 keeps the compose services up after `repro.sh rust-integration` for debugging.
# KEEP_SERVICES=1

# 1 makes scripts/ci/all.sh run the Playwright web e2e (needs Chromium).
# FOTOKO_WEB_E2E=1

# Simulated stack for the web e2e (scripts/e2e/*.sh):
#   state directory (logs, pids, printer output); default scripts/e2e/.sim
# FOTOKO_E2E_DIR=
#   1 = reuse binaries and web export of the last run
# FOTOKO_E2E_SKIP_BUILD=0
#   path of an existing Chromium for Playwright instead of the downloaded one
# FOTOKO_E2E_CHROMIUM=
# Written by sim-up.sh into $FOTOKO_E2E_DIR/env.sh and read by Playwright (do not set by hand;
# FOTOKO_E2E_WEB_URL defaults to http://127.0.0.1:18081):
# FOTOKO_E2E_WEB_URL=
# FOTOKO_E2E_API_URL=
# FOTOKO_E2E_PAYOS_URL=
# FOTOKO_E2E_SIM_OUT_STAND_001=
# FOTOKO_E2E_SIM_OUT_STAND_002=
# FOTOKO_E2E_PI_PID_STAND_002=

# Helper processes of the simulation (set by sim-up.sh and docker-compose.yml):
#   payOS mock (fotoko-payos-mock): listen address (default 127.0.0.1:0), the URL a browser
#   uses to reach it, and the API it posts signed webhooks to. It also reads PAYOS_CLIENT_ID,
#   PAYOS_API_KEY and PAYOS_CHECKSUM_KEY (section 2) and requires them.
# PAYOS_MOCK_ADDR=127.0.0.1:8082
# PAYOS_MOCK_PUBLIC_URL=http://localhost:8082
# FOTOKO_API_URL=http://127.0.0.1:8787
#   Embedded MQTT broker (fotoko-sim-broker) listen address, default 127.0.0.1:1883.
# FOTOKO_BROKER_ADDR=127.0.0.1:1883
#   Static app + API proxy of the e2e stack (scripts/e2e/gateway.mjs).
# GATEWAY_PORT=18081
# GATEWAY_HOST=127.0.0.1
# API_URL=http://127.0.0.1:8787
# STATIC_DIR=scripts/e2e/.sim/dist-web

# Fake CUPS (fotoko-printer-sim fake lp/lpstat/cancel, used with printer.backend = "cups" in
# tests): state directory, sheets before paper_out, latency per job, comma separated queues,
# and the default destination (PRINTER, then LPDEST, as the real CUPS tools do).
# FAKE_CUPS_DIR=
# FAKE_CUPS_PAPER=50
# FAKE_CUPS_LATENCY_MS=0
# FAKE_CUPS_QUEUES=fotoko
# PRINTER=
# LPDEST=

# =====================================================================================
# 7. CI / GitHub (nothing here is read from this file)
#    GitHub environment VARIABLE (not an env var of your machine), one per environment dev
#    and prod, set at Settings -> Environments -> <env> -> Variables; see below.
#    No long-lived AWS keys and no repository secrets are needed; the workflows use the
#    automatic GITHUB_TOKEN. Set by GitHub runners / the CI scripts: CI, GITHUB_ACTIONS,
#    GITHUB_OUTPUT, GITHUB_STEP_SUMMARY. CI=1 gives repro.sh concise output.
# =====================================================================================

# AWS_DEPLOY_ROLE_ARN: ARN of the IAM role GitHub Actions assumes via OIDC (not a secret).
# Example below; docs/setup/aws.md creates the role.
# AWS_DEPLOY_ROLE_ARN=arn:aws:iam::123456789012:role/fotoko-github-deploy-dev

# =====================================================================================
# 8. Agent tooling (optional, developer machine only; see docs/setup/local-dev.md)
# =====================================================================================

# Free OpenRouter key; enables the OtherSkill UserPromptSubmit hook (skill routing). SECRET.
# https://openrouter.ai/keys . Without it the hook does nothing.
# OPENROUTER_API_KEY=

# Raises Context7 MCP rate limits. Optional. SECRET. https://context7.com/dashboard
# CONTEXT7_API_KEY=

# Chisle (token-saving plugin) switches; see docs/setup/local-dev.md. Optional.
# CHISLE_DEFAULT_MODE=off
# CHISLE_COMPRESS=0
