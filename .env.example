# Copy to .env and fill in. Never commit real values.

# Runtime mode: aws | local
FOTOKO_MODE=local

# AWS resources (deployed Lambdas get these from CDK)
TABLE_NAME=
BUCKET_NAME=
IOT_DATA_ENDPOINT=

# payOS (see docs/contracts.md)
PAYOS_BASE_URL=https://api-merchant.payos.vn
# Deployed: Secrets Manager JSON {clientId,apiKey,checksumKey}
PAYOS_SECRET_ARN=
# Local only
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Public web app URL used for payOS returnUrl/cancelUrl
PUBLIC_APP_URL=http://localhost:8081
DEFAULT_PRICE_VND=10000

# CDK: directory with cargo-lambda output (default <repo>/target/lambda)
FOTOKO_LAMBDA_DIR=

# Expo app: API base URL
EXPO_PUBLIC_API_URL=http://localhost:3000
