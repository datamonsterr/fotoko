# Copy to .env.local. Never commit real values. Only EXPO_PUBLIC_* reaches the app bundle.

# Backend base URL, no trailing slash (the app appends /v1/...)
EXPO_PUBLIC_API_URL=http://localhost:3000

# local (x-fotoko-identity header, no AWS) | aws (Cognito guest + SigV4)
EXPO_PUBLIC_FOTOKO_MODE=local

# aws mode only
EXPO_PUBLIC_AWS_REGION=ap-southeast-1
EXPO_PUBLIC_COGNITO_IDENTITY_POOL_ID=
